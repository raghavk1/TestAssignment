# Environment Variables
NODE_ENV=development
PORT=3000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_TTL=300

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers

# Supplier endpoints (internal service URLs)
SUPPLIER_A_URL=http://localhost:3000
SUPPLIER_B_URL=http://localhost:3000

# Supplier timeout (ms)
SUPPLIER_TIMEOUT_MS=5000

# Logging
LOG_LEVEL=info
